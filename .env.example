# Self-hosted OmniRoute OpenAI-compatible gateway (server-side only).
# Vercel: Project Settings -> Environment Variables (Production and Preview).
AI_GATEWAY_URL=https://omnirote67hb7b78g.duckdns.org/v1
AI_GATEWAY_API_KEY=YOUR_PRIVATE_KEY
SITE_ACCESS_CODE=YOUR_PRIVATE_ACCESS_CODE

# OmniRoute Combo: priority failover across 10 configured models.
AI_MODEL_PRIORITY=website-failover
# Must match the target timeout saved in OmniRoute for website-failover.
AI_TARGET_TIMEOUT_MS=5000
# Must exceed OmniRoute's 60-second combo timeout so gateway failover can finish.
AI_TOTAL_TIMEOUT_MS=65000
